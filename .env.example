# Copy to .env; generate each secret separately. Never commit .env.
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:8080
# Local native development: use an existing PostgreSQL database.
DATABASE_URL=postgres://uptivra:REPLACE_WITH_PASSWORD@localhost:5432/uptivra?sslmode=disable
# Docker Compose overrides DATABASE_URL with its internal database address.
POSTGRES_PASSWORD=
# openssl rand -base64 32
ENCRYPTION_KEY=
# openssl rand -hex 32
CRON_SECRET=
# Only needed while running bootstrap; password must be 14–72 bytes.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional when the Vercel backend has deployment protection enabled:
VERCEL_AUTOMATION_BYPASS_SECRET=
